    <w:p>
      <w:pPr>
        <w:spacing w:after="120"/>
      </w:pPr>
      <w:r>
        <w:t>Wakeup Makeup is a full-featured e-commerce and learning platform built with modern web technologies, designed for the beauty and cosmetics industry. The platform provides comprehensive solutions for product sales, course delivery, appointment booking, and multi-role dashboard management.</w:t>
      </w:r>
    </w:p>
    
    <w:p>
      <w:pPr>
        <w:spacing w:after="200"/>
      </w:pPr>
